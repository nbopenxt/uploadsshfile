<idea-plugin>
    <id>com.openxt.uploadsshfile</id>
    <name>Upload SSH File</name>
    <version>1.0.4</version>
    <vendor email="support@openxt.com" url="https://github.com/openxt/uploadsshfile">openxt</vendor>
    <idea-version since-build="253" until-build="262.*"/>
    <description><![CDATA[
        Upload files/directories to remote servers via SSH SFTP.
        <ul>
            <li>Right-click file/directory → Upload SSH File</li>
            <li>Supports multi-file and batch upload</li>
            <li>MD5 checksum verification</li>
            <li>Post-upload SSH command execution</li>
            <li>Server and path configuration management</li>
        </ul>
    ]]></description>
    <change-notes><![CDATA[
        <b>1.0.4</b>
        <ul>
            <li>修复批处理上传进度条精度与子任务重置问题</li>
            <li>修复 marketplace 验证 API 弃用警告</li>
            <li>构建后自动清理中间产物</li>
        </ul>
        <b>1.0.3</b>
        <ul>
            <li>Fix batch upload progress calculation</li>
            <li>Fix i18n missing keys</li>
            <li>Update deprecated API usages</li>
            <li>Fix plugin configuration defect</li>
        </ul>
    ]]></change-notes>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 插件扩展点配置 -->
    </extensions>

    <actions>
        <!-- 一级菜单：Upload SSH File -->
        <group id="UploadSSHFile.Menu" text="Upload SSH File" popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            
            <!-- 批处理上传子菜单 -->
            <action id="UploadSSHFile.BatchUpload"
                    class="com.openxt.uploadsshfile.action.BatchUploadAction"/>
            
            <!-- 单次上传文件子菜单 -->
            <action id="UploadSSHFile.Upload"
                    class="com.openxt.uploadsshfile.action.UploadAction"/>
            
            <!-- 服务器配置子菜单 -->
            <action id="UploadSSHFile.Config"
                    class="com.openxt.uploadsshfile.action.ConfigAction"/>
            
            <!-- SSH命令配置子菜单 -->
            <action id="UploadSSHFile.CommandConfig"
                    class="com.openxt.uploadsshfile.action.OpenConfigDialogAction"/>
            
            <!-- AI配置子菜单 -->
            <action id="UploadSSHFile.AIConfig"
                    class="com.openxt.uploadsshfile.action.OpenAIConfigDialogAction"/>
            
            <!-- 导入导出配置子菜单 -->
            <action id="UploadSSHFile.ImportExportConfig"
                    class="com.openxt.uploadsshfile.action.ImportExportConfigAction"/>
        </group>
    </actions>
</idea-plugin>
